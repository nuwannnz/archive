---
// @ts-ignore
import { Icon } from "astro-icon";
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">Powered by the Latest Technologies</h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">
    <!-- Icons for each technology -->
    <Icon class="h-8 md:h-12" name="simple-icons:react" />
    <Icon class="h-8 md:h-12" name="simple-icons:mongodb" />
    <Icon class="h-8 md:h-12" name="simple-icons:node-dot-js" />
    <Icon class="h-8 md:h-12" name="simple-icons:amazonaws" />
    <Icon class="h-8 md:h-12" name="simple-icons:netlify" />
  </div>
</div>
