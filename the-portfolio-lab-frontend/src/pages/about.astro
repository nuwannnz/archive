---
import { getCollection } from 'astro:content';
import { Picture } from '@astrojs/image/components';
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';
import missionImage from 'assets/mission.png';
import approachImage from 'assets/approach.png';
import expertiseImage from 'assets/expertise.png';

// Filter team entries with 'draft: false' & date before current date
const publishedTeamMembers = await getCollection('team', ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
---

<Layout title='About'>
  <Container>
    <Sectionhead>
      <Fragment slot='title'>About thePortfolioLab</Fragment>
      <Fragment slot='desc'>
        Innovating portfolio creation for professionals.
      </Fragment>
    </Sectionhead>

    <div class='flex flex-col gap-3 mx-auto max-w-4xl mt-16'>
      <h2 class='font-bold text-3xl text-gray-800'>
        Crafting Digital Experiences.
      </h2>
      <p class='text-lg leading-relaxed text-slate-500'>
        At thePortfolioLab, we’re driven by the passion to empower artists,
        designers, photographers, and all creatives. Our diverse team brings
        together a blend of expertise and vision, dedicated to building tools
        that enhance online portfolios.
      </p>
    </div>
    <div class='grid md:grid-cols-3 gap-10 mx-auto max-w-4xl mt-12'>
      <div class='group'>
        <div class="w-full aspect-square">
          <Picture
            src={missionImage}
            alt={"missionImage"}
            sizes="(max-width: 800px) 100vw, 400px"
            widths={[200, 400]}
            aspectRatio="1:1"
            background="#ffffff"
            fit="cover"
            position="center"
            class="w-full rounded-md rounded transition group-hover:-translate-y-1 group-hover:shadow-xl"
          />
        </div>
        <div class='mt-4 text-center'>
          <h2 class='text-lg text-gray-800'>Our Mission</h2>
          <h3 class='text-sm text-slate-500'>
            Empowering creatives with cutting-edge digital solutions, we're
            setting new standards in portfolio presentation and client
            interaction.
          </h3>
        </div>
      </div>
      <div class='group'>
        <div class="w-full aspect-square">
          <Picture
            src={expertiseImage}
            alt={"expertiseImage"}
            sizes="(max-width: 800px) 100vw, 400px"
            widths={[200, 400]}
            aspectRatio="1:1"
            background="#ffffff"
            fit="cover"
            position="center"
            class="w-full rounded-md rounded transition group-hover:-translate-y-1 group-hover:shadow-xl"
          />
        </div>
        <div class='mt-4 text-center'>
          <h2 class='text-lg text-gray-800'>Our Expertise</h2>
          <h3 class='text-sm text-slate-500'>
            From web design to user experience, our team is skilled in creating
            portfolios that captivate and engage. Experience design at its best.
          </h3>
        </div>
      </div>
      <div class='group'>
        <div class="w-full aspect-square">
          <Picture
            src={approachImage}
            alt={"approachImage"}
            sizes="(max-width: 800px) 100vw, 400px"
            widths={[200, 400]}
            aspectRatio="1:1"
            background="#ffffff"
            fit="cover"
            position="center"
            class="w-full rounded-md rounded transition group-hover:-translate-y-1 group-hover:shadow-xl"
          />
        </div>
        <div class='mt-4 text-center'>
          <h2 class='text-lg text-gray-800'>Our Approach</h2>
          <h3 class='text-sm text-slate-500'>
            We prioritize your unique vision, ensuring a collaborative,
            transparent, and client-focused journey. Let's build success stories
            together.
          </h3>
        </div>
      </div>
    </div>
  </Container>
</Layout>
